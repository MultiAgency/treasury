{
  "name": "treasury",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "typecheck": "tsc -p .railway && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm test",
    "smoke:assistant": "node --env-file-if-exists=.env scripts/assistant-smoke.ts",
    "backtest:diversified": "node scripts/diversify.ts",
    "backtest:stabilization": "node scripts/stabilization-backtest.ts run",
    "verify:sdk": "node scripts/verify-sdk.ts",
    "test:compatibility": "node scripts/test-compatibility.ts",
    "typecheck:staging": "tsc -p staging && tsc -p staging/tsconfig.money.json",
    "test:staging": "node staging/run-acceptance.mjs"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@multiagency/sdk": "file:vendor/sdk/final-252cba1/multiagency-sdk-0.5.9.tgz",
    "railway": "3.16.0",
    "typescript": "7.0.2"
  }
}
