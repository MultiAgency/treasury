# Copy to .env and fill in. NEVER commit .env. These are the settings the app server (apps/server, #20) reads.
# Names match apps/server/src/config.ts. Add a setting here in the same PR that adds the code reading it.

# --- Platform (server to server; /apps/v1) ------------------------------
# The platform host's origin, where /apps/v1 is served.
TREASURY_PLATFORM_ORIGIN=
# This app's deployment name, as the operator issued its credential.
TREASURY_DEPLOYMENT=
# Path to a 0600 file holding the deployment's tap_ credential. It is read again when it changes, so a rotated
# credential needs no restart. Never put the credential itself in the environment.
TREASURY_CREDENTIAL_FILE=
# On a host that keeps secrets as variables (Railway), the token itself: src/start.ts writes it to TREASURY_CREDENTIAL_FILE,
# 0600, at startup (docs/deploy.md). Locally, leave it unset and keep the file.
TREASURY_CREDENTIAL=

# --- This server ---------------------------------------------------------
# The server's own origin: the sign-in recipient and the only Origin accepted on writes.
TREASURY_PUBLIC_ORIGIN=
PORT=8787
# Reverse proxies in front of the server to trust for the client's address; 0 trusts none.
TREASURY_TRUSTED_PROXY_HOPS=0
# The proposals page's build (web/dist-proposals), served at every path outside /api/. Unset, only the API.
TREASURY_PAGE_DIR=
# The agents watch proposes for: a 0600 JSON file, { "agents": [{ "organization", "agent", "driftPoints"?, "intervalS"?,
# "proposalHours"?, "notify"? }] }. Unset, watch doesn't run.
TREASURY_WATCH_FILE=
# Where watch stores each proposal request before sending it, created 0600. Needed with TREASURY_WATCH_FILE, and,
# beside it, <this path>.holds, why each agent was last reported held, so a restart doesn't announce it again.
TREASURY_REQUESTS_FILE=
# Owner-page requests a signed-in account may make a minute; each may cost a call against the platform's shared quota.
OWNER_REQUESTS_PER_MINUTE=60
# New consents a signed-in account may relay a day: the platform caps a deployment's unexpired consents, revoked ones included.
CONSENTS_PER_DAY=5
# DAO requests (consents and votes) a signed-in member may file a day; the platform allows a deployment 256.
DAO_FILINGS_PER_DAY=20
# How often the open DAO requests are read, so a passed vote is completed in time; each is one platform call a pass.
DAO_READ_INTERVAL_MS=60000
# The most open DAO requests one pass reads, the least recently read first: 5 a minute is at most 300 of the shared 1,200 calls an hour.
DAO_READS_PER_PASS=5
# Where relayed owner actions (consents, revocations) are recorded: an append-only file of JSON lines, created 0600.
TREASURY_AUDIT_FILE=
# Where the DAO requests this server files are kept until they end, created 0600 on first use.
TREASURY_DAO_REQUESTS_FILE=

# --- Chain (optional) ----------------------------------------------------
# Overrides the chain RPC; otherwise FastNEAR's.
NEAR_RPC_URL=
# FastNEAR's API key (a secret): sent only to FastNEAR's hosts.
FASTNEAR_API_KEY=
