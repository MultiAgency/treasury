# Agentic Treasury Management — backend configuration. Never commit credentials or state.
# API key from https://partners.demo.agentsonintents.com/
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=

# CLI owner scripts only; the dashboard obtains explicit wallet or DAO signatures.
# Use a dedicated low-value owner account. These keys stay server-side.
AGENT_OWNER_ACCOUNT_ID=
AGENT_OWNER_PRIVATE_KEY=

# Saved by agent creation and owner-authorized grant issuance.
AGENT_ID=
AGENT_GRANT_TOKEN=
AGENT_GRANT_TOKEN_PENDING=

# Optional linked funding account: a regular NEAR account or Sputnik DAO.
TREASURY_ACCOUNT=
TREASURY_CONFIDENTIAL=

# Standalone server identity remains Treasury even if its current policy disallows swaps.
DASHBOARD_AREA=treasury

# Optional separate Treasury instance settings. Set ENV_FILE in the process environment.
# ENV_FILE=.env.treasury pnpm server
# Exactly one executor per agent; all other instances must use EXECUTOR=off.
# EXECUTOR=off
# Scheduling is off unless explicitly enabled after strategy authorization.
# AUTOPILOT=
# GRANT_PURPOSE=treasury

# Hosted gateway: use Treasury configuration, never the historical shared-workspace config.
# DASHBOARD_FILE=deploy/treasury.json
# TREASURY_SELF_SERVICE=true
# SESSION_SECRET=<random value of at least 32 characters>
# TRUST_PROXY=true
# Set the configured host to match the public sign-in hostname; see docs/operations.md.

# Optional RPC/indexer configuration; keep backend API keys out of browser code.
# NEAR_RPC_URL=https://rpc.mainnet.fastnear.com
FASTNEAR_API_KEY=

# Optional Treasury notices; no balances or amounts are included in Telegram messages.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_NAME=Treasury agent
# NOTIFY_LINK=https://treasury.multiagency.ai/a/<agent-name>

# Read-only owner-run hosted checks; neither command authorizes an operation.
# DASHBOARD_URL=https://treasury.multiagency.ai
# SMOKE_COOKIE_FILE=/private/path/to/session
# SMOKE_SNAPSHOT=/private/path/to/snapshot.json
# REPORT_COOKIE_FILE=/private/path/to/session
# REPORT_AGENT=<registered treasury name; optional when exactly one is accessible>
# REPORT_EXPECTED_USD=5
# REPORT_REQUIRE_SCHEDULE=true   # only for a scheduled-run demonstration

# Optional hidden Steward demo (/a/<agent-name>/steward or standalone /steward).
# Backend inference credential from https://cloud.near.ai/dashboard; never expose it in the browser.
# NEARAI_API_KEY=

# Optional historical integrations and their environment variables are documented under docs/legacy/.
