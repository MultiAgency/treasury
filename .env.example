# Copy to .env and fill in. NEVER commit .env. Server-only secrets must not use a public/browser prefix.
# Adapted to the MultiAgency app route (@multiagency/sdk 0.4.0, /apps/v1).

# --- Mode ---------------------------------------------------------------
# sim = simulated prices + simulated provider (no funds). live = real MultiAgency (staging/hosted).
BALLAST_MODE=sim
SERVER_PORT=8787

# --- MultiAgency app route (A1 / H3) — server only ----------------------
# Base URL of the host serving /apps/v1 (simulated stack prints it; staging URL comes from the operator).
MULTIAGENCY_API_URL=
# The treasury agent name (the stack's default is "portfolio").
MULTIAGENCY_AGENT=portfolio
# Deployment id for the app (stack: --app <deployment>).
MULTIAGENCY_APP_ID=
# tap_ service credential issued to the deployment. The stack writes it to a 0600 "app-credential" file named in state.json.
MULTIAGENCY_SERVICE_TOKEN=
# The owner must sign a consent naming the agent and the `treasury` scope before the credential reaches anything.

# --- NEAR ---------------------------------------------------------------
NEAR_NETWORK=
NEAR_OWNER_ACCOUNT_ID=
# Account used to write the hourly audit anchor (A7)
NEAR_ANCHOR_ACCOUNT_ID=
NEAR_ANCHOR_PRIVATE_KEY=

# --- Price oracle (H5 / A3): three independent sources ------------------
PRICE_SOURCE_1_URL=
PRICE_SOURCE_2_URL=
PRICE_SOURCE_3_URL=

# --- Alerts (H11 / A15) -------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: NEAR AI Cloud strategy notes (A16) ----------------------
NEAR_AI_API_KEY=

# --- Storage ------------------------------------------------------------
AUDIT_LOG_PATH=./data/audit.jsonl
