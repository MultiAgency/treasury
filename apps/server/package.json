{
  "name": "@treasury/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "test:stack": "node --test --test-concurrency=1 test/stack.e2e.ts test/dao-stack.e2e.ts",
    "test:sandbox": "node --test test/sandbox.e2e.ts",
    "check:anchors": "node src/anchor-check.ts",
    "check:replay": "node src/replay-check.ts"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@multiagency/sdk": "0.5.2",
    "near-kit": "0.20.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
